# trien-khai/cau-hinh.mau.env — CẤU HÌNH MẪU cho trien-khai/chay-vllm.sh
#
# ════════════════════════════════════════════════════════════════════════════
# TỆP NÀY KHÔNG CHỨA BÍ MẬT, VÀ KHÔNG ĐƯỢC CHỨA BÍ MẬT.
#
#   Nó nằm trong một kho CÔNG KHAI. Chép nó ra rồi mới điền:
#
#       cp trien-khai/cau-hinh.mau.env cau-hinh.env
#       $EDITOR cau-hinh.env
#       set -a; . ./cau-hinh.env; set +a
#       trien-khai/chay-vllm.sh --chi-kiem
#
#   `cau-hinh.env` KHÔNG bị .gitignore của kho bắt (mẫu ở đó là `.env` và `.env.*`).
#   Đặt tên khác đi, hoặc thêm dòng cho nó, TRƯỚC khi điền khoá vào. Kiểm bằng:
#       git check-ignore -v cau-hinh.env
#   Không in ra gì nghĩa là tệp ấy SẼ được commit.
#
#   Hai khoá KHÔNG bao giờ viết vào tệp này, kể cả bản đã chép ra:
#     HUGGING_FACE_HUB_TOKEN   — chỉ export ở phiên đang chạy, hoặc dùng trình quản
#                                lý khoá của máy. Đo 26/09/2026: kho Gemma 4 31B khai
#                                gated = false nên thường KHÔNG cần khoá này.
#     VLLM_API_KEY             — khoá bảo vệ chính API vLLM. Xem mục cuối tệp.
# ════════════════════════════════════════════════════════════════════════════


# ── 1 · Trọng số: lấy ở đâu ──────────────────────────────────────────────────

# Mã mô hình trên Hugging Face. Đổi giá trị này chỉ khi phục vụ một mô hình khác.
# Trọng số là CỦA GOOGLE, giấy phép Apache-2.0. BDSG PHỤC VỤ chúng, không sở hữu.
MO_HINH_GEMMA=google/gemma-4-31B-it

# Thư mục trọng số ĐÃ CÓ SẴN trên đĩa (phải chứa config.json). Đây là đường ĐƯỢC
# KHUYẾN NGHỊ: kịch bản khởi động khi ấy không chạm mạng lần nào.
# Bản BF16 khoảng 62,5 GB, nên tải riêng một lần rồi trỏ vào đây.
DUONG_DAN_TRONG_SO=/srv/trong-so/gemma-4-31b-it

# Đặt "co" để cho phép vLLM tự kéo trọng số từ Hugging Face khi chưa có trên đĩa.
# Mặc định "khong" là CỐ Ý: mặc định tải 62,5 GB là một tai nạn băng thông chờ sẵn.
# Chỉ một trong hai dòng trên có tác dụng — DUONG_DAN_TRONG_SO được ưu tiên.
CHO_PHEP_TAI_TRONG_SO=khong


# ── 2 · Tên mô hình khai ra ngoài ────────────────────────────────────────────

# Tên hiện ở /v1/models và ở nhãn "câu trả lời đến từ …" trên giao diện chat.
# ⚠ Kịch bản CHẶN tên có chữ "bdsg" khi BDSG_DA_TINH_CHINH khác "co". Lý do: tên ấy
#   nói với người đọc rằng BDSG đã huấn luyện ra trọng số — không đúng với trọng số
#   Google nguyên bản. Đây là cùng một luật với trường bdsg_la_trong_so_bdsg.
TEN_PHUC_VU=gemma-4-31b-it

# Chỉ đặt "co" khi CHÍNH BDSG đã huấn luyện/tinh chỉnh ra tệp trọng số đang nạp.
# Đặt "co" cho trọng số Google nguyên bản là một lời khai sai, và là đúng thứ bảng
# trạng thái trong README tồn tại để chống.
BDSG_DA_TINH_CHINH=khong


# ── 3 · Nghe ở đâu ───────────────────────────────────────────────────────────

# ⚠ MẶC ĐỊNH LÀ LOOPBACK, VÀ ĐỪNG ĐỔI CHO TỚI KHI CÓ ĐĂNG NHẬP.
#   Bản này CHƯA CÓ lớp xác thực người dùng. Đổi sang 0.0.0.0 là mở một API sinh chữ
#   cho cả mạng nội bộ, không ai phải đăng nhập, không có nhật ký "ai đã hỏi gì".
#   Cần cho nhiều người dùng thì đặt một lớp xác thực ở trước, đừng mở cổng này ra.
DIA_CHI_NGHE=127.0.0.1
CONG_NGHE=8000


# ── 4 · Ngữ cảnh — chỗ tốn VRAM nhất sau trọng số ───────────────────────────

# ⚠ CẢNH BÁO 256K. Mô hình khai max_position_embeddings = 262.144. ĐỪNG lấy số ấy
#   làm giá trị ở đây. 10 trong 60 lớp dùng chú ý TOÀN CỤC, và KV cache của 10 lớp
#   ấy tăng TUYẾN TÍNH theo độ dài ngữ cảnh.
#
#   Số TÍNH RA (chưa đo), KV cache cho MỘT chuỗi, K và V tính tách rời:
#       8.192 token →   ~3,3 GiB
#      32.768 token →  ~10,8 GiB
#     262.144 token →  ~80,8 GiB      ← nhiều hơn cả trọng số BF16
#
#   Nhân tiếp với SO_CHUOI_DONG_THOI ở dưới. Ngữ cảnh 256K với 4 chuỗi cần ~323 GiB
#   riêng cho KV cache — kịch bản sẽ dừng và nói thẳng con số ấy.
#
#   Tự kiểm lại bảng trên:  trien-khai/chay-vllm.sh --tu-kiem
NGU_CANH_TOI_DA=8192

# Số chuỗi vLLM xử lý song song. Đây là núm chỉnh THÔNG LƯỢNG, và nó nhân thẳng vào
# KV cache.
#
# Vì sao mặc định là 2 chứ không phải 4 — đây là một con số ĐÃ BỊ SỬA, ghi lại để
# người sau không đặt lại như cũ. Bản đầu của tệp này ghi 4 kèm câu "vừa một card
# 80 GB". Chạy phép tính ra thì SAI: tổng cần ở mức 4 là 75.136 MiB, còn một card
# 80 GB ở TY_LE_BO_NHO_GPU=0.90 chỉ cho dùng 73.403 MiB (H100 80GB báo 81.559 MiB).
# Thiếu ~1.700 MiB, và kiểu thiếu ấy không hỏng lúc khởi động mà hỏng lúc tải đỉnh.
#
# Bảng tổng cần ở ngữ cảnh 8.192, BF16 (chạy thật bằng --chi-kiem ngày 26/09/2026):
#     1 chuỗi → 65.056 MiB   ·   2 chuỗi → 68.416 MiB   ·   3 chuỗi → 71.776 MiB
#     4 chuỗi → 75.136 MiB   ·   8 chuỗi → 88.576 MiB
# Mức 2 để lại ~5 GiB dư trên card 80 GB. Tăng lên khi đã ĐO được máy của mình.
SO_CHUOI_DONG_THOI=2


# ── 5 · Bộ nhớ và lượng tử hoá ───────────────────────────────────────────────

# Phần VRAM vLLM được phép chiếm. Chừa lại ~10% cho trình điều khiển và tiến trình
# khác. Đẩy lên 0.98 thì hay gặp lỗi hết bộ nhớ lúc tải đỉnh, khi đã phục vụ được
# một lúc — tức là hỏng vào đúng lúc khó chẩn đoán nhất.
TY_LE_BO_NHO_GPU=0.90

# Để TRỐNG = BF16, không lượng tử hoá. Giá trị hiểu được: fp8 · awq · awq_marlin ·
# gptq · gptq_marlin · bitsandbytes · compressed-tensors
#
# ⚠ ĐỌC TRƯỚC KHI BẬT. Phiên tra cứu 26/09/2026 đo được rằng NĂNG LỰC GỌI CÔNG CỤ
#   nhạy với lượng tử hoá gấp khoảng 70 lần so với trả lời chữ thường: Gemma-3 12B ở
#   Q4_K_M rớt 91,3% → 69,0% trên BFCL, tức −22,3 điểm. Độ nhạy ấy PHỤ THUỘC HỌ MÔ
#   HÌNH, và CHƯA AI ĐO Gemma 4 ở INT4 cho gọi công cụ.
#   ⇒ Chạy 31B ở INT4 là một RỦI RO ĐÃ BIẾT. Phải tự đo trước khi hứa với ai.
#   Chi tiết: tai-lieu/GEMMA4-31B.md, mục cảnh báo lượng tử hoá.
LUONG_TU_HOA=

# Kiểu dữ liệu khi KHÔNG lượng tử hoá. Trọng số gốc là BF16; đặt float16 là tự thêm
# một bước đổi kiểu không ai yêu cầu.
KIEU_DU_LIEU=bfloat16

# Số GPU chia mô hình ra (tensor parallel). Trọng số BF16 ~58,3 GiB không vừa một
# card 48 GB, nên trên card nhỏ thì hoặc tăng số này, hoặc lượng tử hoá.
# Kịch bản dừng nếu số này lớn hơn số GPU thật nvidia-smi nhìn thấy.
#
# ⚠ SỐ NÀY LÀ SỐ CARD ĐƯỢC DÙNG, KHÔNG PHẢI SỐ CARD CÓ TRONG MÁY. vLLM chỉ trải mô
#   hình lên đúng ngần này card; các card còn lại nó không đụng tới, nên VRAM của
#   chúng KHÔNG được cộng vào phép kiểm. Một máy 4 × 24 GB để SO_GPU_SONG_SONG=1 thì
#   chỗ thật sự có là 24 GB chứ không phải 96 GB — kịch bản tính đúng như vậy và sẽ
#   dừng. (Bản đầu của kịch bản cộng tổng cả 4 card và cho qua nhầm; sửa 26/09/2026,
#   có phép thử ngược ở nhóm 4b của `--tu-kiem`.)
#   Máy trộn nhiều cỡ card: kịch bản lấy card NHỎ NHẤT trong nhóm, vì tensor parallel
#   chia đều nên card nhỏ nhất là chỗ thắt.
SO_GPU_SONG_SONG=1


# ── 6 · Môi trường chạy ──────────────────────────────────────────────────────

# Trình thông dịch Python CÓ vLLM. Đặt khi vLLM nằm trong một môi trường ảo riêng.
PYTHON_VLLM=python3


# ── 7 · Khoá — KHÔNG ĐIỀN VÀO TỆP NÀY ────────────────────────────────────────
#
# VLLM_API_KEY bảo vệ chính API vLLM. Kịch bản KHÔNG truyền nó qua dòng lệnh, vì
# dòng lệnh đọc được bằng `ps` từ một tài khoản khác trên cùng máy; vLLM tự đọc biến
# môi trường. Đặt nó ở phiên đang chạy, đừng viết vào tệp:
#
#     read -rs -p 'Khoá API vLLM: ' VLLM_API_KEY; export VLLM_API_KEY
#
# Khoá ấy KHÔNG phải một hệ đăng nhập: nó là một chuỗi dùng chung cho mọi người gọi,
# nên không trả lời được câu "ai đã hỏi gì". Bản này chỉ dành cho DEMO MỘT NGƯỜI
# trên localhost.
#
# HUGGING_FACE_HUB_TOKEN: đặt cùng cách, và chỉ khi Hugging Face trả 401/403.
